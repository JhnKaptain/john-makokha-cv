      opacity: 0;
    }
  }
  .cld-tooltip {
    position: absolute;
    z-index: 10000;
    display: block;
    visibility: visible;
    opacity: 1;
  }
  .cld-tooltip-hidden {
    display: none;
  }
  .cld-tooltip-placement-top,
  .cld-tooltip-placement-topLeft,
  .cld-tooltip-placement-topRight {
    padding: 5px 0 ${e=>e.theme.spacing.xxs} 0;
  }
  .cld-tooltip-placement-right,
  .cld-tooltip-placement-rightTop,
  .cld-tooltip-placement-rightBottom {
    padding: 0 5px 0 ${e=>e.theme.spacing.xxs};
  }
  .cld-tooltip-placement-bottom,
  .cld-tooltip-placement-bottomLeft,
  .cld-tooltip-placement-bottomRight {
    padding: ${e=>e.theme.spacing.xxs} 0 5px 0;
  }
  .cld-tooltip-placement-left,
  .cld-tooltip-placement-leftTop,
  .cld-tooltip-placement-leftBottom {
    padding: 0 ${e=>e.theme.spacing.xxs} 0 5px;
  }
  .cld-tooltip-inner {
    min-height: 34px;
  }
  .cld-tooltip-arrow {
    display: none;
  }
